<mxfile host="test">
  <diagram id="a" name="Main page">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Base" parent="0" />
        <mxCell id="hiddenLayer" value="Notes layer" parent="0" visible="0" />
        <UserObject label="%name% (%team%)" placeholders="1" name="Billing" team="Payments" tooltip="Owns invoices" link="https://example.com" id="obj">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;customKey=42;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="120" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="lane" value="Lane" style="swimlane;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="inLane" value="&lt;b&gt;Bold&lt;/b&gt;&lt;br&gt;second line" style="shape=mxgraph.flowchart.decision;html=1;" vertex="1" parent="lane">
          <mxGeometry x="40" y="50" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="folded" value="Folded" style="rounded=0;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="insideFolded" value="Inside" style="ellipse;" vertex="1" parent="folded">
          <mxGeometry x="10" y="40" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Hidden note" style="shape=note;" vertex="1" parent="hiddenLayer">
          <mxGeometry x="500" y="40" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="odd" value="Odd" style="shape=weirdThing;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon" value="Lambda" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;verticalLabelPosition=bottom;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="obj" target="inLane">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="200" y="70" /><mxPoint x="200" y="110" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e1label" value="calls" style="edgeLabel;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loose" value="out" style="endArrow=classic;dashed=1;" edge="1" parent="1" source="odd">
          <mxGeometry relative="1" as="geometry"><mxPoint x="650" y="220" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dangling" style="" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="b" name="Second">
    <mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="x" value="Only" vertex="1" parent="1"><mxGeometry x="0" y="0" width="80" height="40" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
