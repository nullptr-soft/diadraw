{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["EMSDK", "DIADRAW_BUILD_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DIADRAW_WEB_BASE", "VITE_GOOGLE_CLIENT_ID", "VITE_ONEDRIVE_CLIENT_ID"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["VITE_GOOGLE_CLIENT_ID", "VITE_ONEDRIVE_CLIENT_ID"],
      "cache": false,
      "persistent": true
    }
  }
}
