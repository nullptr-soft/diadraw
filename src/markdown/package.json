{
  "name": "@diadraw/markdown",
  "version": "0.0.8",
  "description": "Renders ```diadraw code blocks in Markdown as diagrams: a remark plugin and a markdown-it plugin for build time, and diadraw.js for the browser.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "diadraw",
    "diagram",
    "markdown",
    "remark",
    "remark-plugin",
    "markdown-it",
    "svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    },
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "default": "./dist/satteri.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "default": "./dist/markdown-it.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./diadraw.js": "./dist/embed/diadraw.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@diadraw/wasm": "*",
    "hast-util-from-html": "^2.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "esbuild": "^0.25.0",
    "markdown-it": "^14.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satteri": "^0.11.7",
    "unified": "^11.0.5"
  }
}
