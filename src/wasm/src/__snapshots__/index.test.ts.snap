exports[`@diadraw/wasm > renders every view of the sample documents as standalone SVG > uml-03-activity-order.draw activity 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="324" height="776" viewBox="-20 -20 324 776">
<defs><marker id="dd-m-classic-f-475569" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569"/></marker></defs>
<rect class="dd-background" x="-20" y="-20" width="324" height="776" fill="#ffffff"/>
<g class="dd-edge" data-id="begin-&gt;receive"><path d="M142,40 L142,60" fill="none" stroke="#475569" stroke-width="1.25" marker-end="url(#dd-m-classic-f-475569)"/></g>
