{
  "name": "@diadraw/confluence-drawio",
  "version": "0.0.8",
  "description": "Diagrams drawn in the draw.io editor for Confluence Cloud: an Atlassian Forge app whose macro bundles the draw.io editor, opens it in embed mode and shows the saved drawing in the page.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "fetch-drawio": "node scripts/fetch-drawio.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "forge:lint": "forge lint",
    "forge:deploy": "npm run build && forge deploy",
    "forge:install": "forge install --product confluence"
  },
  "dependencies": {
    "@forge/bridge": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2"
  }
}
