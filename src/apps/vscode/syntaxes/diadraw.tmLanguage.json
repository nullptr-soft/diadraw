{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DiaDraw",
  "scopeName": "source.diadraw",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#namedRelationship" },
    { "include": "#declaration" },
    { "include": "#view" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.diadraw", "match": "//.*$" },
        { "name": "comment.block.diadraw", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.diadraw",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "name": "constant.character.escape.diadraw", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.double.diadraw",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.diadraw", "match": "\\\\." }]
        }
      ]
    },
    "namedRelationship": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(=)(?=\\s*[A-Za-z_][\\w.]*\\s*(?:-->|<->|->))",
      "captures": {
        "1": { "name": "entity.name.relationship.diadraw" },
        "2": { "name": "keyword.operator.assignment.diadraw" }
      }
    },
    "declaration": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(=)\\s*([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?)",
      "captures": {
        "1": { "name": "entity.name.type.element.diadraw" },
        "2": { "name": "keyword.operator.assignment.diadraw" },
        "3": { "name": "support.type.kind.diadraw" }
      }
    },
    "view": {
      "match": "\\b(view)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.diadraw" },
        "2": { "name": "entity.name.section.view.diadraw" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.diadraw",
          "match": "\\b(model|view|group|port|of|theme|extends)\\b"
        },
        {
          "name": "keyword.other.diadraw",
          "match": "\\b(include|exclude|layout|direction|spacing|pin|at|below|above|left|right|up|down|align|horizontally|vertically|order|route|via|from|to|size|sequence|activate|deactivate|over|divider|delay|ref|autonumber|alt|opt|loop|par|critical|break|else|note|text|box|around|rotate)\\b"
        },
        {
          "name": "storage.modifier.diadraw",
          "match": "\\b(tech|shape|tag|description|style|prop|relationship|north|south|east|west)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.diadraw", "match": "<->|-->|->" },
        { "name": "variable.language.wildcard.diadraw", "match": "\\*" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.diadraw",
      "match": "-?\\b\\d+(\\.\\d+)?\\b"
    }
  }
}
