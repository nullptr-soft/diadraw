{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiaDraw",
  "version": "0.0.8",
  "identifier": "dev.diadraw.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @diadraw/web -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx turbo run build --filter=@diadraw/web...",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiaDraw",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Diagrams as code, with a canvas",
    "copyright": "Copyright © 2026 Andriy Mykulyak",
    "license": "MIT",
    "licenseFile": "../../../../LICENSE",
    "fileAssociations": [
      {
        "ext": ["draw"],
        "name": "DiaDraw diagram",
        "role": "Editor",
        "mimeType": "text/x-diadraw"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
