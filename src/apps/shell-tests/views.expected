--- text
// a comment that must survive
model {
  user = person "Customer"
  shop = system "Shop"
  db = database "Orders"
  user -> shop "browses"
}

view main {
  include *
  layout layered direction down
}

view detail {
  include *
}
--- status
"9bad" is not a view name: use letters, digits and _, not starting with a digit
