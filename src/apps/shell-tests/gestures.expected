// a comment that must survive
model {
  user = person "Customer"
  shop = system "Shop"
  db = database "Order store"
  user -> shop "buys from"
  shop -> db
  process1 = process "New process"
}

view main {
  include *
  layout layered direction down
  align user db horizontally
}
