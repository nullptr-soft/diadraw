selected: shop
ok   selection
--- text
// a comment that must survive
model {
  user = person "Customer"
  shop = system "Shop"
  db = database "Orders"
  user -> shop "browses"
}

view main {
  include *
  layout layered direction down
  pin user at 73, 72
  pin db at 172, 80
}
