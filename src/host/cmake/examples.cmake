# Writes examples.inc for src/host/src/examples.cpp: one `{ "name", "source" },` entry per .draw
# file in `dir`, sorted by name, as raw string literals. A literal is cut into pieces of at most
# 8000 bytes at line ends (MSVC caps one literal at 16 KB, and a cut at a line end never splits a
# UTF-8 character); the pieces are joined again into one literal, which compilers cap at 64 KB,
# so a larger file is refused. Runs at configure time; the files are configure dependencies, so
# adding, removing or editing an example re-runs it.
function(diadraw_write_examples dir output)
  file(GLOB files CONFIGURE_DEPENDS "${dir}/*.draw")
  set(names "")
  foreach(file IN LISTS files)
    get_filename_component(name "${file}" NAME_WLE)
    if(NOT name MATCHES "^[A-Za-z0-9.-]+$")
      message(FATAL_ERROR "${file}: an example's name may only hold letters, digits, '.' and '-'")
    endif()
    list(APPEND names "${name}")
  endforeach()
  if(names STREQUAL "")
    message(FATAL_ERROR "no examples (*.draw) in ${dir}")
  endif()
  list(SORT names)
  set(content "// Generated by src/host/cmake/examples.cmake from corpus/*.draw. Do not edit.\n")
  foreach(name IN LISTS names)
    set(file "${dir}/${name}.draw")
    file(READ "${file}" text)
    string(REPLACE "\r" "" text "${text}")
    string(FIND "${text}" ")dd\"" clash)
    if(NOT clash EQUAL -1)
      message(FATAL_ERROR "${file} contains )dd\", which ends the raw string it is embedded in")
    endif()
    string(LENGTH "${text}" length)
    if(length GREATER 60000)
      message(FATAL_ERROR "${file} is ${length} bytes; an example is embedded as one literal of at most 60000")
    endif()
    string(APPEND content "{\"${name}\",\n")
    set(offset 0)
    while(offset LESS length)
      string(SUBSTRING "${text}" ${offset} 8000 piece)
      string(LENGTH "${piece}" n)
      math(EXPR rest "${length} - ${offset}")
      if(n LESS rest)
        # Not the last piece: end it after its last line break.
        string(FIND "${piece}" "\n" newline REVERSE)
        if(newline EQUAL -1)
          message(FATAL_ERROR "${file} has a line longer than 8000 bytes")
        endif()
        math(EXPR n "${newline} + 1")
        string(SUBSTRING "${piece}" 0 ${n} piece)
      endif()
      string(APPEND content "R\"dd(${piece})dd\"\n")
      math(EXPR offset "${offset} + ${n}")
    endwhile()
    if(length EQUAL 0)
      string(APPEND content "\"\"\n")
    endif()
    string(APPEND content "},\n")
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  # Rewritten only when it changed, so a re-run does not rebuild the host library.
  set(old "")
  if(EXISTS "${output}")
    file(READ "${output}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${output}" "${content}")
  endif()
endfunction()
